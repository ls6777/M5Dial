# Settings this project relies on. ESP-IDF applies these whenever sdkconfig is (re)generated,
# e.g. after "idf.py set-target" or deleting sdkconfig.

# M5Stack Dial: ESP32-S3 (M5StampS3) with 8 MB flash and no PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# The StampS3 has no USB to UART bridge: the console is the ESP32-S3's own USB Serial/JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 ms tick: the task monitor evaluates every 10 ms, DELAY_MS() is accurate, and GetTimeMs() wraps cleanly at 2^32 ms
CONFIG_FREERTOS_HZ=1000

# Needed by TargetPort::GetTaskList() and TargetPort::GetRunTimeStats() (vTaskList() and vTaskGetRunTimeStats())
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# The task monitor kicks the task watchdog. When a task violates its checkin timeout, the monitor stops kicking it
# and the watchdog must reset the device (without PANIC it only prints a warning).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
